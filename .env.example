# PaySphere Environment Variables
# ─────────────────────────────────────────────────────────────────
# COPY this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/paysphere_dev
DB_USER=paysphere
DB_PASSWORD=changeme_local_only

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Razorpay (TEST MODE ONLY — use rzp_test_ prefix keys) ─────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET_HERE
RAZORPAY_MODE=test

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_64_character_random_string_for_hs512
JWT_EXPIRY_SECONDS=3600

# ── Application ───────────────────────────────────────────────────
APP_ENV=local
SERVER_PORT=8080

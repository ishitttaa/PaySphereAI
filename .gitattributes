# Normalize line endings to LF in the repository
# Windows checkouts will use CRLF; Linux/Mac will use LF
* text=auto

# Force LF for these file types (scripts, config, source)
*.java      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf

# Windows batch files stay CRLF on Windows
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary files — do not touch line endings
*.jar       binary
*.zip       binary
*.png       binary
*.jpg       binary
*.ico       binary
